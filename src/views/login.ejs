<%- include('partials/header') %>

<div class="page-wrapper">
    <div class="logo-header">
        <img src="/images/logo-sgp.webp" alt="SGP - Sistema de Gerenciamento de Presença">
    </div>

    <div class="card">
        <h1 class="card__title">Entrar</h1>

        <% if (error) { %>
            <div class="alert alert--error" style="display: flex; align-items: center; gap: 8px;">
                <i data-lucide="triangle-alert" class="w-5 h-5 flex-shrink-0"></i> <span><%= error %></span>
            </div>
        <% } %>

        <form action="/entrar" method="POST">
            <div class="form-group">
                <input type="text" name="username" class="form-input" placeholder="Usuário" required autocomplete="username" id="login-username">
            </div>
            <div class="form-group">
                <input type="password" name="password" class="form-input" placeholder="Senha" required autocomplete="current-password" id="login-password">
            </div>
            <button type="submit" class="btn btn--primary btn--lg" id="login-submit">Entrar</button>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
